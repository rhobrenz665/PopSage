# Pooled application connection string. Keep server-only.
DATABASE_URL=

# Direct connection string used only by Drizzle migrations.
DATABASE_URL_UNPOOLED=

# Branch-specific Managed Neon Auth endpoint.
NEON_AUTH_BASE_URL=

# A random secret of at least 32 characters. Never commit a real value.
NEON_AUTH_COOKIE_SECRET=

# Public application origin used to validate same-origin auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
