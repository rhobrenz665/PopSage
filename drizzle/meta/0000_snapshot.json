        "invitation_kind_valid": {
          "name": "invitation_kind_valid",
          "value": "\"invitations\".\"kind\" in ('owner_onboarding','teammate')"
        },
        "invitation_status_valid": {
          "name": "invitation_status_valid",
          "value": "\"invitations\".\"status\" in ('pending','accepted','revoked','replaced')"
        },
        "invitation_kind_workspace": {
          "name": "invitation_kind_workspace",
          "value": "(\"invitations\".\"kind\" = 'owner_onboarding' and \"invitations\".\"workspace_id\" is null) or (\"invitations\".\"kind\" = 'teammate' and \"invitations\".\"workspace_id\" is not null)"
        },
        "invitation_email_canonical": {
          "name": "invitation_email_canonical",
          "value": "\"invitations\".\"email\" = lower(trim(\"invitations\".\"email\")) and length(\"invitations\".\"email\") between 3 and 254"
        },
        "invitation_hash_sha256": {
          "name": "invitation_hash_sha256",
          "value": "\"invitations\".\"token_hash\" ~ '^[a-f0-9]{64}$'"
        },
        "invitation_expiry_72h": {
          "name": "invitation_expiry_72h",
          "value": "\"invitations\".\"expires_at\" = \"invitations\".\"created_at\" + interval '72 hours'"
        },
        "invitation_acceptance_consistent": {
          "name": "invitation_acceptance_consistent",
          "value": "(\"invitations\".\"status\" = 'accepted') = (\"invitations\".\"accepted_at\" is not null and \"invitations\".\"accepted_by_user_id\" is not null and \"invitations\".\"accepted_workspace_id\" is not null)"
        },
        "invitation_replacement_consistent": {
          "name": "invitation_replacement_consistent",
          "value": "(\"invitations\".\"status\" = 'replaced') = (\"invitations\".\"replaced_by_selector\" is not null)"
        }
      },
